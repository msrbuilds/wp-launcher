# Claude Code local settings
.claude/settings.local.json

# Dependencies
node_modules/

# Build output
dist/
packages/dashboard/dist/
packages/api/dist/

# Environment & secrets
.env
.env.local
.env.production

# Database
data/
# Manual copies taken before migrations (data.live, data.pre-v3-backup, ...)
data.*/

# Site wp-content bind mounts (runtime dir at the repo root only — anchored so
# it doesn't also swallow packages/dashboard/src/pages/sites/).
/sites/
*.db
*.db-shm
*.db-wal

# Traefik SSL certificates
traefik/acme.json

# Product assets — only track .zip files, ignore extracted directories
product-assets/**/plugins/*/
product-assets/**/themes/*/
!product-assets/**/*.zip
!product-assets/**/demo-content.xml

# Products — only track defaults and demos
products/*
!products/_default.json
!products/demo-*.json

# Templates — only track defaults
templates/*
!templates/.gitkeep
!templates/starter.json
# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*

# Plans, reports & tests
plans/
reports/
tests/
# ...but keep the tracked superpowers spec/plan docs (specs/ is already tracked).
!docs/superpowers/plans/
!docs/superpowers/plans/**

# Docker
docker-compose.override.yml

# Extensions — track source and the shipped artifacts in extensions/dist/,
# ignore per-package dependencies and build output.
extensions/*/node_modules/
extensions/*/dist/
extensions/*/out/
extensions/*/build/
extensions/*/.vscode-test/
# VSIXes are build output in a package root; the shipped copies live in
# extensions/dist/ and stay tracked.
extensions/*-wpl-productivity/*.vsix

# Generated
version.json
packages/api/version.json

# TypeScript's incremental build cache. Machine-local and rewritten by every
# build, so tracking it puts a churning binary-ish diff in unrelated PRs.
*.tsbuildinfo

# Playwright MCP scratch output
.playwright-mcp/
