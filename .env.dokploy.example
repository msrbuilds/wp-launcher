# WP Launcher on Dokploy — paste into the app's Environment tab.
# See guides/dokploy-deployment.md.

# ─── Domain ──────────────────────────────────────────────────────────────────
# Sites are created as {subdomain}.BASE_DOMAIN, so BASE_DOMAIN needs a wildcard
# DNS A record (*.wplauncher.xyz) pointing at this host, plus a record for the
# apex used by the panel itself.
BASE_DOMAIN=wplauncher.xyz
PUBLIC_URL=https://wplauncher.xyz

# ─── Secrets (generate: openssl rand -hex 32) ────────────────────────────────
API_KEY=
JWT_SECRET=
PROVISIONER_INTERNAL_KEY=

# ─── Absolute host paths ─────────────────────────────────────────────────────
# These are bind-mounted into WordPress containers by the host Docker daemon,
# so they must be paths on the HOST, not inside a container. Replace <app-name>
# with the Dokploy application name. They live under files/ because Dokploy
# deletes code/ on every redeploy.
PRODUCT_ASSETS_PATH=/etc/dokploy/compose/<app-name>/files/product-assets
SITES_HOST_PATH=/etc/dokploy/compose/<app-name>/files/sites

# ─── Routing and TLS ─────────────────────────────────────────────────────────
# TLS terminates once, at Dokploy's Traefik, using a wildcard certificate for
# *.BASE_DOMAIN. That wildcard is REQUIRED — see section 6. Sites sit behind a
# second Traefik on a private network and speak plain HTTP to it, so there is
# no per-site certificate and no ENABLE_TLS/CERT_RESOLVER knob any more.

# Name of the DNS-01 resolver in Dokploy's traefik.yml that holds the wildcard
# certificate. Only change this if you named yours something other than
# `cloudflare`. The token itself lives in Traefik's own environment, not here.
WILDCARD_CERT_RESOLVER=cloudflare

# A Go regular expression matching every site hostname. It cannot be derived
# from BASE_DOMAIN automatically because the dots must be escaped. If your
# domain is example.com, use ^.+\.example\.com$
BASE_DOMAIN_REGEX=^.+\.wplauncher\.xyz$

# Must cover the dokploy-network subnet, so our Traefik trusts the
# X-Forwarded-Proto header Dokploy's Traefik sets. If it does not, WordPress
# believes requests are plain HTTP and every site redirect-loops.
#
# The default below is usually correct and can be left alone: Dokploy's network
# is a Swarm overlay allocated from Docker's default 10.0.0.0/8 pool (10.0.1.0/24
# on a typical install). Confirm with:
#   docker network inspect dokploy-network -f '{{(index .IPAM.Config 0).Subnet}}'
# and only change this if that prints something outside 10.0.0.0/8.
#
# The broad /8 is not a weakness here: site containers live on the wpl-sites
# bridge and get 172.x addresses, so they still cannot spoof the header.
TRAEFIK_TRUSTED_IPS=10.0.0.0/8

# Basic-auth credential guarding Adminer at db.BASE_DOMAIN. Generate with:
#   htpasswd -nbB admin 'your-password'
#
# YOU MUST DOUBLE EVERY `$` IN THE HASH. Compose interpolates env values, so a
# hash pasted verbatim is silently TRUNCATED at the first `$` — Adminer then
# rejects the correct password with no error anywhere explaining why.
#   htpasswd prints: admin:$2y$05$Xk9.../abcdef
#   you must enter:  admin:$$2y$$05$$Xk9.../abcdef
# BASE_DOMAIN_REGEX needs no such escaping: its only `$` is at the end of the
# value, where there is nothing for compose to read as a variable name.
ADMINER_AUTH_USERS=

# ─── Email (required: no mailpit on Dokploy) ─────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WP Launcher <noreply@wplauncher.xyz>

# ─── Limits ──────────────────────────────────────────────────────────────────
CONTAINER_MEMORY=268435456
CONTAINER_CPU=0.5
MAX_SITES_PER_USER=3
